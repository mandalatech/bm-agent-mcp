{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bm-agent-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  // `agents/dist/mcp/client.js` dynamically imports "ai" in the MCP *client*
  // path only; this worker is an MCP *server* and never runs it. Alias "ai" to
  // a local stub so esbuild can resolve the dead import without bundling the
  // full Vercel AI SDK. See ai-stub.mjs.
  "alias": {
    "ai": "./ai-stub.mjs"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BooksMandalaAgentMCP"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "BooksMandalaAgentMCP"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  // Per-client-IP rate limit on the unauthenticated public /mcp endpoint.
  // period must be 10 or 60 (seconds). 100 requests / 60s / IP bounds abuse
  // while leaving ample headroom for a legitimate MCP session's request burst.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}
