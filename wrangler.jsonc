{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bm-agent-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  // `agents/dist/mcp/client.js` dynamically imports "ai" in the MCP *client*
  // path only; this worker is an MCP *server* and never runs it. Alias "ai" to
  // a local stub so esbuild can resolve the dead import without bundling the
  // full Vercel AI SDK. See ai-stub.mjs.
  "alias": {
    "ai": "./ai-stub.mjs"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BooksMandalaAgentMCP"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "BooksMandalaAgentMCP"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
